# Default public registry for environments without private Artifactory access.
# For corporate installs, restore .npmrc.artifactory.bak or set NPM_CONFIG_REGISTRY.
registry=https://registry.npmjs.org/

# Prefer resolving peers correctly; override only when a peer conflict is documented.
# legacy-peer-deps was previously required for the Angular 21 migration; keep until peer graph is clean.
legacy-peer-deps=true

sass_binary_site=https://npmmirror.com/mirrors/node-sass/
