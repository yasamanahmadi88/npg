            <column name="POR_OP_ORG" type="string"/>
            <column name="POR_RSP_CODE" type="string"/>
            <column name="POR_RSP_NOTE" type="string"/>
            <column name="POR_CANCEL_NOTE" type="string"/>
            <column name="POR_MNPID" type="string"/>
            <column name="PORTATION_DATE" type="date"/>
            <column name="PORTA_CODE" type="string"/>
            <column name="MVNO" type="string"/>
            <column name="CONTEXT" type="string"/>
            <column name="POR_ERR_CODE" type="string"/>
            <column name="POR_ERR_MESSAGE" type="string"/>
            <column name="POR_OPD" type="string"/>
            <column name="POR_NUM_TYPE" type="string"/>
            <column name="POR_NOTE" type="string"/>
            <column name="POR_DEADLINE" type="date"/>
            <column name="POR_RESPONSE_TIMESTAMP" type="numeric"/>
            <column name="POR_ELIGIBLE" type="numeric"/>
            <column name="POR_BILLING_OK" type="numeric"/>
            <column name="INTERMEDIARY_ACTION_STATE" type="string"/>
            <column name="POR_CR_DATE" type="date"/>
            <column name="POR_UPD_DATE" type="date"/>
            <column name="POR_TECH_STATUS" type="string"/>
            <column name="POR_TECH_DEADLINE" type="date"/>
            <column name="NEED_MANUAL_RETRY" type="numeric"/>
            <column name="REF_POR_ID" type="numeric"/>
            <column name="RETRY_COUNT" type="numeric"/>
            <column name="POR_TYPE_COMPLETE_TIMESTAMP" type="numeric"/>
        </loadData>
    </changeSet>

</databaseChangeLog>