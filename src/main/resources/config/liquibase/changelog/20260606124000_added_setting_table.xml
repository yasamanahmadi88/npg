<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260606124000-1" author="manual">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="SETNG_SEQ"/>
            </not>
        </preConditions>

        <createSequence sequenceName="SETNG_SEQ" startValue="1"/>
    </changeSet>

    <changeSet id="20260606124000-2" author="manual">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="setting"/>
            </not>
        </preConditions>

        <createTable tableName="setting">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="PK_SETTING" nullable="false"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="jhi_key" type="varchar(70)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UK_STNG_KEY"/>
            </column>
            <column name="jhi_value" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>