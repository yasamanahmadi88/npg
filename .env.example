# Environment variable template for NPG Portal.
# Copy to a local `.env` (never commit real values) or export in your shell / CI secrets store.

# --- Runtime ---
# SPRING_PROFILES_ACTIVE=dev

# --- Database (Oracle) ---
# Dev defaults exist in application-dev.yml; override for local/shared DBs.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/NPGPDB
SPRING_DATASOURCE_USERNAME=npg
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT (required for prod profile) ---
# Generate with: openssl rand -base64 64
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=replace-with-base64-secret-at-least-64-bytes

# --- Optional mail ---
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=25
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# --- Frontend (dev proxy targets backend on 8080 by default) ---
# SERVER_API_URL=
